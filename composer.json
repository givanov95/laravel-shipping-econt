{
    "name": "givanov95/laravel-shipping-econt",
    "description": "Econt as a delivery method of a Laravel shop: the API client and the adapter to the contract of givanov95/laravel-shipping",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "shipping", "delivery", "courier", "econt", "ecommerce"],
    "authors": [
        {
            "name": "Georgi Ivanov",
            "email": "joroz95@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "brick/money": "^0.15",
        "givanov95/laravel-shipping": "^0.1",
        "givanov95/typed-http": "^2.1",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "givanov95/laravel-git-hooks": "^1.1",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Givanov95\\Shipping\\Econt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Givanov95\\Shipping\\Econt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Givanov95\\Shipping\\Econt\\EcontServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "allow-plugins": {
            "givanov95/laravel-git-hooks": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
